# Copy to .env and fill in. Never commit .env.

# PostgreSQL (the db container creates this user/database on first start)
POSTGRES_USER=fitness
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fitness_db
# Host "db" is the compose service; postgresql:// is normalized to the psycopg 3 driver
DATABASE_URL=postgresql://fitness:change-me@db:5432/fitness_db

# Timezone for "today" and day boundaries
APP_TZ=Europe/Prague
# Host port (localhost only); `tailscale serve --bg <APP_PORT>` exposes it over HTTPS
APP_PORT=8010
# Host uid/gid for files the containers write into the repo (dev bind mount, backups); see `id -u` / `id -g`
HOST_UID=1000
HOST_GID=1000

# Daily database dumps (backup service): directory on the host and the local hour they run
BACKUP_DIR=./data/backups
BACKUP_HOUR=3

# Shared secret for /api/webhooks/* (iOS Shortcut, Health Connect forwarder); webhooks are off while empty
WEBHOOK_TOKEN=

# Life Dashboard Companion (Health Connect forwarder): optional HMAC secret (alternative to the token header)
# and the apps whose records count (comma-separated package names, "*" = all)
HEALTH_CONNECT_SECRET=
HEALTH_CONNECT_ORIGINS=com.sec.android.app.shealth

# Strava API app (https://www.strava.com/settings/api); callback domain = your tailnet hostname
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Public HTTPS origin used for OAuth redirects, e.g. https://myserver.tailnet-name.ts.net
PUBLIC_BASE_URL=

# Gemini (Phase 2). Model ids from the live list; the smart tier falls back to the fast one.
# Free tier has no Pro quota; set GEMINI_MODEL_SMART to a Pro model once billing is enabled.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.7-flash
GEMINI_MODEL_SMART=
# Thinking level per tier (minimal | low | medium | high)
GEMINI_THINKING_FAST=low
GEMINI_THINKING_SMART=high

# Running knowledge base on GitHub (owner/repo), synced read-only for the coach
COACH_KB_REPO=
COACH_KB_BRANCH=master
